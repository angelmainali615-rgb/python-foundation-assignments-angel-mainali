    "# Exercise 1: Batch Processor\n",
    "\n",
    "for batch_number in range(1, 11):\n",
    "    print(f\"Processing batch {batch_number}\")\n",
    "    \n",
    "    # After every 3rd batch\n",
    "    if batch_number % 3 == 0:\n",
    "        print(\"Checkpoint reached\")"
